{
  "compilerOptions": {
    "target": "ES2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      "@oya/database": ["packages/database/src/index.ts"],
      "@oya/database/*": ["packages/database/src"],
    },
  },
}
